generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tradeLogs  TradeLog[]
  signalLogs SignalLog[]
}

enum Role {
  ADMIN
  TRADER
  VIEWER
}

// ─── Logs ────────────────────────────────────────────────────────────────────

model TradeLog {
  id          String    @id @default(cuid())
  userId      String?
  conditionId String
  question    String
  asset       String
  direction   String
  amount      Float
  entryPrice  Float
  exitPrice   Float?
  pnl         Float?
  mode        String
  status      String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SignalLog {
  id          String   @id @default(cuid())
  userId      String?
  conditionId String
  question    String
  asset       String
  direction   String
  confidence  Int
  provider    String
  reasoning   String?
  indicators  Json?
  latencyMs   Int?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ApiLog {
  id         String   @id @default(cuid())
  service    String
  endpoint   String
  statusCode Int
  latencyMs  Int
  error      String?
  createdAt  DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Watchlist ────────────────────────────────────────────────────────────────

model MarketOverride {
  id             String   @id @default(cuid())
  conditionId    String   @unique
  question       String
  asset          String
  pinned         Boolean  @default(false)
  notes          String?
  signalOverride String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
