{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/trade/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/markets/[conditionId]/signal/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/settings/verify-key/route.ts": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
